import utils.file_utils, utils.ui_utils, utils.dialog_utils, utils.apkbuilder

activity.getWindow().setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE)
activity.getActionBar().hide()

preference = Preferences(activity)

# global variables
savedText = null
openfile = []
project = null
parentDirectory = []
rootpath = null
adapter = null
AdapterData = []
result = 0
resourceId = activity.getResources().getIdentifier("status_bar_height", "dimen", "android");

tab_gone = {visibility: "gone"}
tab_visible = {visibility: "visible"}
selected = 0
OLData = []
editor = null

ReplaceEnabled = false
findAndReplaceOpen = false
findAndReplaceCase = false
findAndReplaceRegex = false

// visibility
visible = 0
gone = 8

if resourceId > 0 then
  result = activity.getResources().getDimensionPixelSize(resourceId);
end

function fileMenuBuilder(path)
  callback = {
    onMenuItemClick: function(item)
      id = item.getItemId()
      if id == 0 then
        FileUtil.deleteFile(path)
        openFolder(parentDirectory[-1])
        adapter.notifyDataSetChanged()
      elif id == 1 then
        renameFile(path.getParent(), path.getName())
      elif id == 2 then
        file_utils.copyToClipboard(activity, path.getName())
      elif id == 3 then
        file_utils.copyToClipboard(activity, path.getAbsolutePath())
      end
      return true
    end
  }

  return {
    visibility: "visible",
    onClick: function(v)
      pop=PopupMenu(activity, v)
      menu=pop.getMenu()
  
      menu.add(0, 0, 0, "Delete")
      menu.add(0, 1, 0, "Rename")
      menu.add(0, 2, 0, "Copy name")
      menu.add(0, 3, 0, "Copy path")
      
      pop.setOnMenuItemClickListener(callback)
      
      pop.show();
    end
  }
end

function openFolder(_path)
  AdapterData.clear()
  AdapterData.append({
    icon: "icons/folder.png",
    type: "folder",
    title: "../",
    path: _path,
    subtitle: "Return to parent directory"
  })
  jlist = FileUtil.listDir(_path)
  length = java.length(jlist)
  
  for j in 0..(length) do
    i = jlist.get(j)
    icon = "icons/file.png"
    type = "file"
    title = i.getName()

    if i.isDirectory() then
      icon = "icons/folder.png"
      type = "folder"
    end

    path = i.getAbsolutePath()
    modified = FileUtil.formatDate(i.lastModified(), "dd MMM yyyy, hh:mm a")
    filemenu = fileMenuBuilder(i)

    AdapterData.append({icon: icon, type: type, title: title, subtitle: modified, path: path, filemenu: filemenu})
  end
end

function createFile()
  parent = null
  if parentDirectory is List and parentDirectory.length then
    parent = parentDirectory[-1]
  end

  ll = LoadLayout(activity)
  objects = ll.getObjects()
  dialog = dialog_utils.createDialog(activity, ll.createView(loadfile(saynaadir .. "/utils/layout/createfile.ly")))

  name = objects.name
  cancel = objects.cancel
  file = objects.file
  folder = objects.folder
  
  file.setOnClickListener({
    onClick: function(v)
      value = name.getText()
      
      if (value == "") then
        name.setError("Enter file name");
        return;
      end
      
      if parent == null then
        java.toast("error Parent is null")
      end
      
      if file_utils.createFile(parent .. "/" .. value) then
        openFolder(parentDirectory[-1])
        adapter.notifyDataSetChanged()
      end
      dialog.dismiss()
    end
  })
  
  
  folder.setOnClickListener({
    onClick: function(v)
      value = name.getText()
      
      if (value == "") then
        name.setError("Enter folder name");
        return;
      end

      if parent == null then
        java.toast("error Parent is null")
      end
      
      if file_utils.createDirectory(parent .. "/" .. value) then
        openFolder(parentDirectory[-1])
        adapter.notifyDataSetChanged()
      end

      dialog.dismiss()
    end
  })
  
  cancel.setOnClickListener({
    onClick: function(v)
      dialog.dismiss()
    end
  })
end


function renameFile(parent, originalName)
  ll = LoadLayout(activity)
  objects = ll.getObjects()
  dialog = dialog_utils.createDialog(activity, ll.createView(loadfile(saynaadir .. "/utils/layout/renamefile.ly")))

  name = objects.name
  cancel = objects.cancel
  rename = objects.rename
  
  name.setText(originalName)
  
  rename.setOnClickListener({
    onClick: function(v)
      value = name.getText()
      
      if (value == "") then
        name.setError("Enter file name");
        return;
      end
      
      if parent == null then
        java.toast("error Parent is null")
      end
      
      src = parent .. "/" .. originalName
      des = parent .. "/" .. value
      
      if FileUtil.isDirectory(src) then
        FileUtil.copyDir(src, des)
      else
        FileUtil.copyFile(src, des)
      end
      FileUtil.deleteFile(src)
      openFolder(parentDirectory[-1])
      adapter.notifyDataSetChanged()

      dialog.dismiss()
    end
  })
  
  cancel.setOnClickListener({
    onClick: function(v)
      dialog.dismiss()
    end
  })
end


assert(activity != null, 'activity is null')

Layout = {
  DrawerLayout,
  id: "mDrawer",
  loadfile("editor_layout.ly"),
  loadfile("editor_drawer.ly")
}

root = loadlayout(activity, Layout)
assert(root != null, 'loadlayout returned null')
activity.setContentView(root)

symbols = loadfile(saynaadir .. "/editor_symbols.ly")
searcher = null
nonPrintablePaintingFlags = CodeEditor.FLAG_DRAW_WHITESPACE_LEADING | CodeEditor.FLAG_DRAW_WHITESPACE_IN_SELECTION

function onKeyDown(c,e)
  if c==4 then
    if mDrawer.isDrawerOpen(3) then
      mDrawer.closeDrawer(3)
      return true
    end
    if openfile.find(selected) != -1 then
      file_utils.writeFile(openfile[selected], editor.getText())
    end
    
    if findAndReplaceOpen then
      closeFindAndReplace()
      return true
    end
  end
end

function markSaved(text)
  savedText = text
end

function isModified(text)
  return savedText == text
end

function jumpToLine(editor, lineNumber)
  if editor == null then
    return
  end

  if lineNumber < 1 then
    lineNumber = 1
  end

  // Sora uses zero-based line indexes
  line = lineNumber - 1

  text = editor.getText()
  lineCount = text.length

  if lineCount <= 0 then
    return
  end

  if line >= lineCount then
    line = lineCount - 1
  end

  column = 0

  editor.setSelection(line, column)
  editor.ensureCursorVisible()
  editor.ensureSelectionVisible()
end

function closeFindAndReplace()
  findAndReplaceOpen = false     
  findreplace.setVisibility(gone)
  ReplaceEnabled = false
  replaceSection.setVisibility(gone)
  btnall.setEnabled(false);
  replace.setText("")
  find.setText("")
end

function newCodeEditor(data)
  code = CodeEditor(activity)
  code.setTextSize(16)
  code.setDark(theme.isDarkMode())
  code.setLayoutParams(LinearLayout.LayoutParams(-1, -1))
  code.setText(data)
  return code
end

wordwrap = false
readonly = false
blanksymbol = false

function editorProperties(_editor)
  _editor.setWordwrap(wordwrap)
  _editor.setEditable(not readonly);
  if blanksymbol then
    _editor.setNonPrintablePaintingFlags(nonPrintablePaintingFlags);
  else
    _editor.setNonPrintablePaintingFlags(0);
  end
end

function onCreate(bundle)
  if bundle == null then
    java.toast("bundle is null")
    return
  end
  
  project = bundle.getString("project")
  name = bundle.getString("name")
  title.setText(name)

  OLAdapter = SaynaaAdapter(activity, loadfile("editor_items.ly"), OLData)
  openList.setAdapter(OLAdapter)
  openList.setOnItemClickListener(AdapterView.OnItemClickListener({
    onItemClick: function(parent, view, position, id)
      if position == selected then
        return
      end

      OLData[selected].scrollbar = tab_gone
      OLData[position].scrollbar = tab_visible
      OLAdapter.notifyDataSetChanged()
      selected = position

      editor = OLData[position].codeEditor
      editorProperties(editor)
      searcher = OLData[position].editorSearcher
      openList.setSelection(selected)
      pagev.showPage(selected)
    end
  }))
  
  pageAdapter = ArrayPageAdapter()
  
  openList.setOnItemLongClickListener(({
    onItemLongClick: function(parent, view, position, id)
      pop=PopupMenu(activity, view)
      menu=pop.getMenu()
      
      count = openfile.length
      if count <= 1 then
        return true
      end
      
      if position == 0 then
        menu.add(0, 0, 0, "Close Other")
      else
        menu.add(0, 1, 0, "Close")
      end
      
      pop.setOnMenuItemClickListener({
        onMenuItemClick: function(item)
          id = item.getItemId()
          if id == 0 then
            // i will close others and skip 0
            for i in 1..(count) do
              OLData.pop(i)
              openfile.pop(i)
              pageAdapter.remove(i)
            end
            
            pageAdapter.notifyDataSetChanged()
            OLAdapter.notifyDataSetChanged()
          elif id == 1 then
            oldSelected = selected
            
            pageAdapter.remove(position)
            OLData.pop(position)
            openfile.pop(position)
            
            if position < oldSelected then
              selected = oldSelected - 1
            
            elif position == oldSelected then
              selected = oldSelected
            
              if selected >= OLData.length then
                selected = OLData.length - 1
              end
            end
            
            if selected < 0 then
              selected = 0
            end
            
            for i in 0..(OLData.length - 1) do
              OLData[i].scrollbar = tab_gone
            end
            
            OLData[selected].scrollbar = tab_visible
            
            editor = OLData[selected].codeEditor
            editorProperties(editor)
            searcher = OLData[selected].editorSearcher
            
            OLAdapter.notifyDataSetChanged()
            pageAdapter.notifyDataSetChanged()
            openList.setSelection(selected)
            pagev.showPage(selected)
          end
          return true
        end
      })
      pop.show();
      return true
    end
  }))

  openfile.append(project .. "/main.sa")
  buffer = file_utils.readFile(openfile[-1])
  
  editor = newCodeEditor(buffer)
  searcher = editor.getSearcher()
  OLData.append({ 
    text: 'main.sa',
    scrollbar: tab_visible,
    codeEditor: editor,
    editorSearcher: searcher
  })
  
  pageAdapter.add(editor)
  pagev.setAdapter(pageAdapter)
  
  pagev.addOnPageChangeListener({
    onPageSelected: function(position)
      OLData[selected].scrollbar = tab_gone
      OLData[position].scrollbar = tab_visible
      OLAdapter.notifyDataSetChanged()
      selected = position

      editor = OLData[position].codeEditor
      editorProperties(editor)
      searcher = OLData[position].editorSearcher
    end
  })

  buttonBarStyle = activity.getResources().getIdentifier("android:attr/buttonBarButtonStyle", null, null)
  
  for i in symbols do
    btn = Button(activity, null, buttonBarStyle)
    btn.setText(i.title)
    btn. setTextColor(theme.text)
    anon = function(sym) 
      btn.setOnClickListener({
        onClick: function(v)
          editor.pasteText(sym);
        end
      })
    end
    anon(i.insert)
    symbolBar.addView(btn)
  end
  
  redo.setOnClickListener({
    onClick: function(v)
      editor.redo();
    end
  })

  btn.setOnClickListener({
    onClick: function(v)
     mDrawer.openDrawer(3)
    end
  })

  undo.setOnClickListener({
    onClick: function(v)
      editor.undo();
    end
  })

  run.setOnClickListener({
    onClick: function(v)
      file_utils.writeFile(openfile[selected], editor.getText())
      activity.newActivity(project .. "/main")
    end
  })
  
  drawer_add.setOnClickListener({
    onClick: function(v)
      createFile()
    end
  })
  
  pop=PopupMenu(activity, btnmenu)
  menu=pop.getMenu()
  
  menu.add(0, 0, 0, "Search")
  menu.add(0, 1, 0, "Build")
  menu.add(0, 2, 0, "Word wrap").setCheckable(true)
  menu.add(0, 3, 0, "Read-only mode").setCheckable(true)
  menu.add(0, 4, 0, "Show blank symbol").setCheckable(true)
  menu.add(0, 5, 0, "Properties")
  menu.add(0, 6, 0, "About")
  
  pop.setOnMenuItemClickListener({
    onMenuItemClick: function(item)
        id = item.getItemId()
        if id == 0 then
          findreplace.setVisibility(visible)
          findAndReplaceOpen = true
          find.requestFocus()
        elif id == 1 then
          apkbuilder.BuildApk(activity, project)
        elif id == 2 then
          wordwrap = not item.isChecked()
          item.setChecked(wordwrap)
          editor.setWordwrap(wordwrap)
        elif id == 3 then
          readonly = not item.isChecked()
          item.setChecked(readonly)
          editor.setEditable(not readonly);
        elif id == 4 then
          blanksymbol = not item.isChecked()
          item.setChecked(blanksymbol)
          if blanksymbol then
            editor.setNonPrintablePaintingFlags(nonPrintablePaintingFlags);
          else
            editor.setNonPrintablePaintingFlags(0);
          end
        elif id == 5 then
          b = Bundle()
          b.putString('project', project)
          activity.newActivity("properties", b)
        elif id == 6 then
          activity.newActivity("about")
        end
        return true
    end
  })
  
  btnmenu.setOnClickListener({
    onClick: function(v)
     pop.show();
    end
  })
  
  
  // findreplace section
  fr_pop=PopupMenu(activity, btnmore)
  fr_menu=fr_pop.getMenu()
  
  fr_menu.add(0, 0, 0, "Regex").setCheckable(true)
  fr_menu.add(0, 1, 0, "Match case").setCheckable(true)
  fr_menu.add(0, 2, 0, "Close")

  fr_pop.setOnMenuItemClickListener({
    onMenuItemClick: function(item)
        id = item.getItemId()
        if id == 0 then
          findAndReplaceRegex = not item.isChecked()
          item.setChecked(findAndReplaceRegex)

          // Trigger afterTextChanged
          find.setText(find.getText())
        elif id == 1 then
          findAndReplaceCase = not item.isChecked()
          item.setChecked(findAndReplaceCase)

          // Trigger afterTextChanged
          find.setText(find.getText())
        elif id == 2 then
          closeFindAndReplace()
        end
        return true
    end
  })
  
  btnmore.setOnClickListener({
    onClick: function(v)
     fr_pop.show();
    end
  })

  find.addTextChangedListener({
    afterTextChanged: function(s)
      if s.length > 0 then
        searcher.search(s, EditorSearcher.SearchOptions(not findAndReplaceCase, findAndReplaceRegex))
      else
        searcher.stopSearch()
      end
    end
  })
  
  btnnext.setOnClickListener({
    onClick: function(v)
      if not searcher.hasQuery() or searcher.getMatchedPositionCount() == 0 then
        java.toast("Text not found")
        return
      end

      searcher.gotoNext();
    end
  })
  
  btnprev.setOnClickListener({
    onClick: function(v)
      if not searcher.hasQuery() or searcher.getMatchedPositionCount() == 0 then
        java.toast("Text not found")
        return
      end

      searcher.gotoPrevious()
    end
  })
  
  btnreplace.setOnClickListener({
    onClick: function(v)
      if not ReplaceEnabled then
        ReplaceEnabled = true
        replaceSection.setVisibility(visible)
        btnall.setEnabled(true);
        return
      end
      if not searcher.hasQuery() or searcher.getMatchedPositionCount() == 0 then
        java.toast("Text not found")
        return
      end

      searcher.replaceCurrentMatch(replace.getText())
    end
  })
  
  btnall.setOnClickListener({
    onClick: function(v)
      if not searcher.hasQuery() or searcher.getMatchedPositionCount() == 0 then
        java.toast("Text not found")
        return
      end

      searcher.replaceAll(replace.getText())
    end
  })
  
  save.setOnClickListener({
    onClick: function(v)
     file_utils.writeFile(openfile[selected], editor.getText())
     java.toast("Save successful")
    end
  })
  
  rootpath = project
  parentDirectory = [rootpath]

  openFolder(rootpath)

  adapter = SaynaaAdapter(activity, loadfile(saynaadir .. "/utils/layout/filemanager.ly"), AdapterData)
  drawer_list.setAdapter(adapter)

  isSingleTab = preference.getBoolean("single_tab", true)
  drawer_list.setOnItemClickListener(({
    onItemClick: function(parent, view, position, id)
      data = AdapterData[position]
      
      if data.type == "file" then
        name = data.title
        
        extension = ['sa', 'ly', 'cfg', 'txt', 'json', 'md', 'html', 'css', 'js']
        if name.split(".")[-1] in extension then
          if isSingleTab then
            file_utils.writeFile(openfile[selected], editor.getText())
            OLData[selected].text = name
            openfile[selected] = data.path
            buffer = file_utils.readFile(openfile[-1])
            editor.setText(buffer)
            OLAdapter.notifyDataSetChanged()
            mDrawer.closeDrawer(3)
            return
          end
          file_pos = openfile.find(data.path)
          if file_pos != -1 then
            OLData[selected].scrollbar = tab_gone
            OLData[file_pos].scrollbar = tab_visible
            OLAdapter.notifyDataSetChanged()
            selected = file_pos

            editor = OLData[file_pos].codeEditor
            editorProperties(editor)
            searcher = OLData[file_pos].editorSearcher
            pagev.showPage(selected)
            openList.setSelection(selected)
            mDrawer.closeDrawer(3)
            return
          end
        
          file_utils.writeFile(openfile[selected], editor.getText())
          openfile.append(data.path)
          
          buffer = file_utils.readFile(openfile[-1])
          editor = newCodeEditor(buffer)
          editorProperties(editor)
          searcher = editor.getSearcher()
          
          OLData.append({ 
            text: name,
            scrollbar: tab_visible,
            codeEditor: editor,
            editorSearcher: searcher
          })
          OLData[selected].scrollbar = tab_gone
          OLAdapter.notifyDataSetChanged()
          selected += 1

          pageAdapter.add(editor)
          pagev.notifyDataSetChanged()
          pagev.showPage(selected)
          openList.setSelection(selected)
          mDrawer.closeDrawer(3)
        end
      else
        currect = parentDirectory[-1]
        if data.title == "../" and currect == rootpath then
          return
        end
        if data.title == "../" then
          parentDirectory.pop()
        else
          goto = currect + "/" + data.title
          parentDirectory.append(goto)
        end
        openFolder(parentDirectory[-1])
        adapter.notifyDataSetChanged()
      end
    end
  }))
end
