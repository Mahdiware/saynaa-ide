import java

mystyle = java.bindClass('com.android.saynaa.R$style')
R_style = java.bindClass('android.R$style')
R_attr = java.bindClass('android.R$attr')
TypedValue = java.bindClass('android.util.TypedValue')
Configuration = java.bindClass("android.content.res.Configuration")
Color = java.bindClass("android.graphics.Color")

lightmode = {
  primary: 0xFF3F51B5,
  secondary: 0xFF5F6B7A,

  background: 0xFFF6F9FF,
  cards: 0xFFE6EFF8,

  text: 0xFF172033,
  textSecondary: 0xFF5F6B7A,

  divider: 0xFFD7E0EA,
  disabled: 0xFF9AA6B2,

  success: 0xFF2E7D32,
  warning: 0xFFED8B00,
  error: 0xFFD32F2F,
  info: 0xFF1976D2,
}

darkmode = {
  primary: 0xFF8C9EFF,
  secondary: 0xFFB0BAC7,

  background: 0xFF10141C,
  cards: 0xFF1E1E1E,

  text: 0xFFF5F7FA,
  textSecondary: 0xFFB0BAC7,

  divider: 0xFF303A48,
  disabled: 0xFF687383,

  success: 0xFF66BB6A,
  warning: 0xFFFFB74D,
  error: 0xFFEF5350,
  info: 0xFF64B5F6,
}

class ThemeManager
  function _init(context)
    this.context = context

    this.styleLight = mystyle.LightTheme2
    this.styleDark = mystyle.DarkTheme2
    
    this.dialogLight = R_style.Theme_DeviceDefault_Light_Dialog_NoActionBar
    this.dialogDark = R_style.Theme_DeviceDefault_Dialog_NoActionBar
  end
  
  // it return missing class attribute
  // like: ThemeManager(context).missingattribute
  function _getattr(name)
    if this.isDarkMode() then
      result = darkmode.get(name)
      if result != null then
        return result
      end
    else
     result = lightmode.get(name)
      if result != null then
        return result
      end
    end
    
    return this.getThemeAsName(name)
  end
  
  function setDarkMode(dark)
    this.context.setSharedData("darkmode", dark)
  end
  
  function isDarkMode()
    default = true
    data = this.context.getSharedData("darkmode")
    if data is Bool then
      return data
    end
    
    return default
  end
  
  function  getDialogTheme()
    if this.isDarkMode() then
      return this.dialogDark
    else
      return this.dialogLight
    end
  end
  
  function getTheme()
    if this.isDarkMode() then
      return this.styleDark
    else
      return this.styleLight
    end
  end
  
  function getColor(attr)
    value = TypedValue();
    if this.context.getTheme().resolveAttribute(attr, value, true)
      return value.data;
    end
    
    return Color.TRANSPARENT;
  end
  
  function getThemeAsName(name)  
    value = TypedValue()  
    attrId = this.context.getResources().getIdentifier(name, "attr", "android")  
  
    if this.context.getTheme().resolveAttribute(attrId, value, true) then  
      return value.data  
    end  
    
    return null  
  end  
  
  function getDrawable(attr)
    value = TypedValue();
    if this.context.getTheme().resolveAttribute(attr, value, true)
      return this.context.getDrawable(value.resourceId)
    end
    
    return null;
  end
  
  function getBoolean(attr)
    value = TypedValue();
    if this.context.getTheme().resolveAttribute(attr, value, true)
      return value.data != 0
    end
    
    return false;
  end
  
  function getDimension(attr)
    value = TypedValue();
    if this.context.getTheme().resolveAttribute(attr, value, true)
      return TypedValue.complexToDimensionPixelSize(value.data, this.context.getResources().getDisplayMetrics());
    end
    
    return 0;
  end
  
  function getResourceId(attr)
    value = TypedValue();
    if this.context.getTheme().resolveAttribute(attr, value, true)
      return value.resourceId;
    end
    
    return 0;
  end
 
  function isSystemDark()
    return (this.context.getResources().getConfiguration().uiMode & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;
  end
  
  function applyTheme()
    this.context.setTheme(this.getTheme())
  end
  
end
