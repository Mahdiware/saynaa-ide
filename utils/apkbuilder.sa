import java, file_utils, validator, Zip, os, path, permissions

File = java.bindClass('java.io.File')
FileOutputStream = java.bindClass('java.io.FileOutputStream')
FileInputStream = java.bindClass('java.io.FileInputStream')
Signer = java.bindClass("apksigner.command.Signer")

function build(context, dlg, config, srcpath, output)
  saynaadir = context.getSaynaaDir()
  
  libPath = context.getApplicationInfo().nativeLibraryDir
  aapt2 = libPath .. "/libaapt2.so"
  aapt2sh = saynaadir .. "/res/aapt2.sh"

  framezip = saynaadir ..  "/res/frame.zip"
  resourcezip = saynaadir ..  "/res/resources.zip"
  
  android = saynaadir .. "/res/android.jar"
  file_dir = str(context.getFilesDir().getParentFile())
  app_cache = file_dir .. "/app_cache"

  tmp_cache = app_cache
  tmp_assets = tmp_cache .. "/assets"
  iconpath = tmp_assets .. "/" .. config.app.icon

  redirect = app_cache .. "/redirect.txt"


  os.system("rm -r $app_cache")
  os.system("mkdir -p $tmp_assets")
  
  if(!path.exists(output)) then
    os.mkdir(output)
  end
  
  if(!path.isdir(output))
    error("Something Wrong!")
  end

  file_utils.compileCode(srcpath, tmp_assets)

  src = app_cache .. "/resources"
  Zip.ZipFile(resourcezip, "r").extractall(src)
  
  frame = app_cache .. "/frame"
  Zip.ZipFile(framezip, "r").extractall(frame)
  
  launcher = src + "/res/drawable/ic_launcher.png"
  strings = src + "/res/values/strings.xml"
  
  content = file_utils.readFile(strings)
  content = content.replace("AppName", config.app.name)
  file_utils.writeFile(strings, content)
  
  if os.system(" cp $iconpath $launcher") != 0
    dlg.setMessage("failed to add icon.png")
  end

  cfg = config
  apkname = config.app.name
  apkpath = output .. "/$apkname-release.apk"

  res = src .. "/res"
  compiled = tmp_cache .. "/res.zip"

  cmd  = "--aapt2 $aapt2 --compile"
  cmd += " --dir $res -o $compiled"
  if os.system("sh $aapt2sh $cmd &>$redirect") != 0 then
    dlg.setMessage("failed to compile")
    return
  end
  
  dlg.setMessage("aapt2 compiling successful")
  
  manifest = src .. "/AndroidManifest.xml"
  
  content = file_utils.readFile(manifest)
  content = content.replace("com.package.name", cfg.app.package)
  
  for i in cfg.permissions do
   // <uses-permission android:name="android.permission.INTERNET" />
   if validator.is_invalid_permission(i) then
     dlg.setMessage("got Invalid permission (ignoring)")
     continue
   end
   
   if content.find(i) != -1 then
     continue
   end
   
   permission = "<uses-permission\n\t\tandroid:name=\"$i\"/>\n\t"
   content = content.replace("<application", permission .. "<application", 1)
  end
  
  file_utils.writeFile(manifest, content)
  
  
  min_sdk = cfg.android.minSdk
  target_sdk = cfg.android.targetSdk
  version_code = cfg.app.versionCode
  version_name = cfg.app.versionName
  resources = tmp_cache .. "/generated.apk"
  
  cmd  = "--aapt2 $aapt2 --link --auto-add-overlay"
  cmd += " --manifest $manifest -I $android"
  cmd += " --min-sdk-version $min_sdk --target-sdk-version $target_sdk"
  cmd += " --version-code $version_code --version-name $version_name"
  cmd += " -R $compiled -o $resources"

  if os.system("sh $aapt2sh $cmd &>$redirect") != 0 then
    dlg.setMessage("failed to link")
    return
  end
  
  dlg.setMessage("aapt2 linking successful")
  
  
  file_utils.addZipFolder(resources, null, frame)
  
  file_utils.addZipFolder(resources, "assets/", tmp_assets)
  
  dlg.setMessage("Signature starts...")
  
  signer = Signer();
  signer.setInputApk(resources);
  signer.setOutputApk(apkpath);
  signer.setV1SigningEnabled(true);
  signer.setV2SigningEnabled(true);
  signer.setV3SigningEnabled(true);
  signer.setV4SigningEnabled(false);
  signer.sign()
  dlg.setMessage("Signature finished")
  dlg.dismiss()
  permissions.installApk(context, apkpath)
end