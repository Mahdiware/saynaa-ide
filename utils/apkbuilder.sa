import java, file_utils, dialog_utils, config_validate
import bytecode_utils, validator, Zip
import os, path, permissions, package

File = java.bindClass('java.io.File')
FileUtil = java.bindClass("com.android.saynaa.utils.FileUtil")
Signer = java.bindClass("apksigner.command.Signer")

function BuildApk(context, project)
  Runnable = java.bindClass("java.lang.Runnable")
  Thread = java.bindClass("java.lang.Thread")
  
  externaldir = context.getSaynaaExtDir()
  
  dlg = dialog_utils.createProgressDialog(context);
  dlg.setTitle("Compiling");
  dlg.setMessage("Building...")
  dlg.setMax(100);
  dlg.show()
  
  runner = Runnable(function()
    dlg.setCancelable(false);
    result = pcall(build, context, dlg, project, externaldir)
    dlg.setCancelable(true);
    if not result[0] then
      file_utils.writeFile(externaldir .. "/build-error.txt", result[1])
      dlg.setMessage("error: " .. str(result[1]))
    end
  end)
  
  thread = Thread(runner)
  thread.start()
end


function build(context, dlg, project, externaldir)
  dlg.setMessage("Preparing build...")

  saynaadir = context.getSaynaaDir()

  libPath = context.getApplicationInfo().nativeLibraryDir
  aapt2 = libPath .. "/libaapt2.so"
  aapt2sh = saynaadir .. "/res/aapt2.sh"

  framezip = saynaadir .. "/res/frame.zip"
  resourcezip = saynaadir .. "/res/resources.zip"

  androidjar = saynaadir .. "/res/android.jar"
  build_dir = externaldir .. "/.build"
  output = externaldir .. "/.bin"

  tmp_assets = build_dir .. "/assets"
  aap2log = build_dir .. "/aapt2.log"

  result = pcall(config_validate.getConfig, project)

  if not result[0] then
    dlg.setMessage("Build failed: " .. str(result[1]))
    return
  end
  config = result[1]

  appname = config.appname
  pkgname = config.pkgname

  dlg.setMessage("Preparing build directory...")
  FileUtil.deleteFile(build_dir)
  FileUtil.makeDir(tmp_assets)

  if not path.exists(output) then
    FileUtil.makeDir(output)
  end

  if not path.isdir(output) then
    dlg.setMessage("Invalid output directory.")
    return
  end

  dlg.setMessage("Copying project files...")
  FileUtil.copyDir(project, tmp_assets)
  
  if bytecode_utils.isBytecodeEnabled(context) then
    dlg.setMessage("Compiling Saynaa code...")
    
    if not bytecode_utils.compileCode(tmp_assets) then
      dlg.setMessage("Failed to compile Saynaa code.")
      return
    end
    
    dlg.setMessage("Saynaa code compiled successfully.")
  end

  dlg.setMessage("Extracting Android resources...")
  src = build_dir .. "/resources"
  Zip.ZipFile(resourcezip, "r").extractall(src)
  
  dlg.setMessage("Extracting Android framework...")
  frame = build_dir .. "/frame"
  Zip.ZipFile(framezip, "r").extractall(frame)
  
  launcher = src + "/res/drawable/ic_launcher.png"
  strings = src + "/res/values/strings.xml"
  
  dlg.setMessage("Configuring application...")
  
  content = file_utils.readFile(strings)
  content = content.replace("AppName", appname)
  file_utils.writeFile(strings, content)
  
  if config.appicon is String then
    FileUtil.copyFile(config.appicon, launcher)
  end

  apkpath = output .. "/$appname-release.apk"

  res = src .. "/res"
  compiled = build_dir .. "/res.zip"

  dlg.setMessage("Compiling Android resources...")

  cmd  = "--aapt2 $aapt2 --compile"
  cmd += " --dir $res -o $compiled"
  
  if os.system("sh $aapt2sh $cmd &>>$aap2log") != 0 then
    dlg.setMessage("Failed to compile Android resources.")
    return
  end
  
  dlg.setMessage("Android resources compiled successfully.")

  manifest = src .. "/AndroidManifest.xml"
  
  dlg.setMessage("Configuring Android manifest...")
  
  content = file_utils.readFile(manifest)
  content = content.replace("com.package.name", pkgname)
  
  for i in config.permissions do
    if validator.is_invalid_permission(i) then
      dlg.setMessage("Invalid permission ignored: $i")
      continue
    end
    
    if content.find(i) != -1 then
      continue
    end
    
    permission = "<uses-permission\n\t\tandroid:name=\"$i\"/>\n\t"
    content = content.replace("<application", permission .. "<application", 1)
  end
  
  file_utils.writeFile(manifest, content)

  # default value
  min_sdk = config.minSdk
  target_sdk = config.targetSdk
  version_code = config.versionCode
  version_name = config.versionName

  resources = build_dir .. "/generated.apk"
  
  dlg.setMessage("Linking Android resources...")

  cmd  = "--aapt2 $aapt2 --link --auto-add-overlay"
  cmd += " --manifest $manifest -I $androidjar"
  cmd += " --min-sdk-version $min_sdk --target-sdk-version $target_sdk"
  cmd += " --version-code $version_code --version-name $version_name"
  cmd += " -R $compiled -o $resources"

  if os.system("sh $aapt2sh $cmd &>>$aap2log") != 0 then
    dlg.setMessage("Failed to link Android resources.")
    return
  end
  
  dlg.setMessage("Android resources linked successfully.")
  
  
  dlg.setMessage("Adding application files...")
  file_utils.addZipFolder(resources, null, frame)
  
  dlg.setMessage("Adding application assets...")
  file_utils.addZipFolder(resources, "assets/", tmp_assets)
  
  dlg.setMessage("Signing APK...")
  
  signer = Signer()
  signer.setInputApk(resources)
  signer.setOutputApk(apkpath)
  signer.setKeyPath(saynaadir .. "/keys");
  signer.setKeyName("testkey");
  signer.setV1SigningEnabled(true)
  signer.setV2SigningEnabled(true)
  signer.setV3SigningEnabled(true)
  signer.setV4SigningEnabled(false)
  signer.sign()
  
  dlg.setMessage("APK signed successfully.")
  
  dlg.dismiss()
  permissions.installApk(context, apkpath)
end