import java, themes
from "../loadlayout.sa" import LoadLayout

// Don't remove these, using in: dialogmessage.ly
LinearLayout = java.bindClass('android.widget.LinearLayout')
TextView = java.bindClass('android.widget.TextView')

function createDialog(context, view)
  AlertDialog = java.bindClass("android.app.AlertDialog")
  Gravity = java.bindClass("android.view.Gravity")
  WindowManager = java.bindClass("android.view.WindowManager")

  theme = themes.ThemeManager(context)

  builder = AlertDialog.Builder(context, theme.getDialogTheme())  
  builder.setView(view)  
  dialog = builder.create()  
  dialog.setCancelable(true);  
  dialog.show();  
    
  window = dialog.getWindow();  
  if (window != null)  
    params = window.getAttributes();  
    params.width = context.getResources().getDisplayMetrics().widthPixels * 0.88;  
    params.height = WindowManager.LayoutParams.WRAP_CONTENT;  
    params.gravity = Gravity.CENTER;  
    window.setAttributes(params);  
  end
  
  return dialog
end

  
function createProgressDialog(context)  
  ProgressDialog = java.bindClass("android.app.ProgressDialog")
  Gravity = java.bindClass("android.view.Gravity")
  WindowManager = java.bindClass("android.view.WindowManager")

  theme = themes.ThemeManager(context)

  dialog = ProgressDialog(context, theme.getDialogTheme());
  dialog.setTitle("Title");
  dialog.setMessage("Message...")
  dialog.setMax(100);
  dialog.show()

  window = dialog.getWindow();  
  if (window != null)  
    params = window.getAttributes();  
    params.width = context.getResources().getDisplayMetrics().widthPixels * 0.88;  
    params.height = WindowManager.LayoutParams.WRAP_CONTENT;  
    params.gravity = Gravity.CENTER;  
    window.setAttributes(params);  
  end
  
  return dialog
end

function dialogMessage(context, title, body)
  saynaadir = context.getSaynaaDir()
  theme = themes.ThemeManager(context)

  ll = LoadLayout(context)
  dialog = createDialog(context, theme.getDialogTheme(), ll.createView(load(saynaadir .. "/utils/layout/dialogmessage.ly")))
  
  objects = ll.getObjects()
  objects.title.setText(title)
  objects.body.setText(body)

  objects.ok.setOnClickListener({
    onClick: function(v) 
      dialog.dismiss()
    end
  })
end
