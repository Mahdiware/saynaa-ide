import java, Zip, path, os, io, compile, package

FileUtil = java.bindClass("com.android.saynaa.utils.FileUtil")

function listPath(dir)
  list = []
  for i in path.listdir(dir) do
    list.append({type: i.type, path: i.path, modified: i.modified, name: i.name})
  end
  return list
end

// treeFolder("/path/assets")
function treeFolder(_path)
  _name = _path.split("/")[-1]
  ret = {
    name: _name,
    path: _path
  }
  
  if path.isdir(_path) then
    ret.type = "directory"
    tree = []
    list = listPath(_path)
    for i in list do
      if i.type == "directory" then
        tree.append(treeFolder(i.path))
      else
        tree.append({
          name: i.name,
          path: i.path,
          type: "File",
          tree: null
        })
      end
    end
    
    ret.tree = tree
  else
    ret.type = "file"
    ret.tree = null
  end

  return ret
end


function addZipHelper(zip, location, map)
  if map.type == "directory" then
    children = map.tree
    if children is List then
      for i in children do
        if i is Map then
          _path = location + i.name
          if i.type == "directory" then
            addZipHelper(zip, _path + "/", i)
          else
            // 9 means: MZ_BEST_COMPRESSION
            zip.write(i.path, _path, 9)
          end
        end
      end
    end
  else
    zip.write(map.path, location + map.name)
  end
end

// ziplocation: can null
function addZipFolder(zippath, ziplocation, foldertozip)
  if ziplocation == null or ziplocation == "/" then
    ziplocation = ""
  end

  z = Zip.ZipFile(zippath, "a")
  map = treeFolder(foldertozip)
  addZipHelper(z, ziplocation, map)
  z.close()
end

function getProjects(dir)
  projects = []
  for i in FileUtil.listDirByRecent(dir) do
    if i.isDirectory() then
      fullpath = i.getAbsolutePath()
      for j in path.listdir(fullpath) do
        if j.name == "app.cfg" then
          projects.append(fullpath)
        end
      end
    end
  end
  return projects
end

function extractFile(zipFile, FileToExtract, PathToSave)
  z = Zip.ZipFile(zipFile, "r")
  data = z.read(FileToExtract)
  writeFile(PathToSave, data)
end

function readFile(file)
  r = io.open(file, "r")
  content = r.read()
  r.close()
  return content
end

function writeFile(file, content)
  r = io.open(file, "w")
  r.write(content)
  r.close()
end

function buildProject(root, name, pkg)
  project = root + "/" + name
  if path.exists(project) then
    return false
  end

  FileUtil.makeDir(project)
  Zip.ZipFile("res/template.zip", "r").extractall(project)
  appcfg = project + "/app.cfg"
  
  content = readFile(appcfg)
  content = content.replace("</>AppName</>", name)
  content = content.replace("</>PackageName</>", pkg)
  writeFile(appcfg, content)

  return true
end

function copyToClipboard(context, text)
  Context = java.bindClass("android.content.Context")
  ClipData = java.bindClass("android.content.ClipData")
  ClipboardManager = java.bindClass("android.content.ClipboardManager")

  clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE)

  clip = ClipData.newPlainText("text", text)
  clipboard.setPrimaryClip(clip)
end

// its better to use saynaa buildin if available future
function createFile(path)
  File = java.bindClass("java.io.File")
  file = File(path)
  if not file.exists() then
    return file.createNewFile()
  end
  return false
end

function createDirectory(path)
  File = java.bindClass("java.io.File")
  dir = File(path)
  if not dir.exists() then
    return dir.mkdirs()
  end
  return false
end

function rename(oldPath, newPath)
  File = java.bindClass("java.io.File")
  return File(oldPath).renameTo(File(newPath));
end

function copyHelper(source, destination)
  Files = java.bindClass("java.nio.file.Files")
  Paths = java.bindClass("java.nio.file.Paths")
  Options = java.bindClass("java.nio.file.StandardCopyOption")

  return Files.copy(Paths.get(source), Paths.get(destination), Options.REPLACE_EXISTING)
end

function copy(source, destination)
  result = pcall(copyHelper, source, destination)
  writeFile(destination .. "/info", "$source -> $destination\n${str(result)}")
  return str(result[1]) == str(destination)
end