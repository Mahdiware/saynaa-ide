import java, Zip, path, io, compile, math

FileUtil = java.bindClass("com.saynaa.utils.FileUtil")

function listPath(dir)
  list = []
  for i in path.listdir(dir) do
    list.append({type: i.type, path: i.path, modified: i.modified, name: i.name})
  end
  return list
end

// treeFolder("/path/assets")
function treeFolder(_path, skipPath)
  _name = _path.split("/")[-1]
  ret = {
    name: _name,
    path: _path
  }
  
  if path.isdir(_path) then
    ret.type = "directory"
    tree = []
    list = listPath(_path)
    for i in list do
      if skipPath is List and i.path in skipPath then
        continue
      end
      if i.type == "directory" then
        tree.append(treeFolder(i.path))
      else
        tree.append({
          name: i.name,
          path: i.path,
          type: "File",
          tree: null
        })
      end
    end
    
    ret.tree = tree
  else
    ret.type = "file"
    ret.tree = null
  end

  return ret
end


function addZipHelper(zip, location, map)
  if map.type == "directory" then
    children = map.tree
    if children is List then
      for i in children do
        if i is Map then
          _path = location + i.name
          if i.type == "directory" then
            addZipHelper(zip, _path + "/", i)
          else
            // 9 means: MZ_BEST_COMPRESSION
            zip.write(i.path, _path, 9)
          end
        end
      end
    end
  else
    zip.write(map.path, location + map.name, 9)
  end
end

// ziplocation: can null
function addZipFolder(zippath, ziplocation, foldertozip, skipPath)
  if ziplocation == null or ziplocation == "/" then
    ziplocation = ""
  end

  z = Zip.ZipFile(zippath, "a")
  map = treeFolder(foldertozip, skipPath)
  addZipHelper(z, ziplocation, map)
  z.close()
end

function formatter(data, pos)
  if not (data is List or data is Map) then
    if data is String then
      return '"' .. data .. '"'
    end
    return data
  end
  
  isList = data is List
  content = isList ? '[' : '{'
  content += "\n"
  pos = pos is Number ? pos : 1

  for i in data do
    content += "  " * pos
    if isList then
      value = formatter(i, pos+1)
      content += "$value,\n"
    else
      value = formatter(data.get(i), pos+1)
      content += "$i: $value,\n"
    end
  end
  
  content += "  " * (pos-1)
  content += isList ? ']' : '}'
  return content
end

function getProjects(dir)
  projects = []
  jlist = FileUtil.listDirByRecent(dir)
  length = java.length(jlist)
  
  for i in 0..(length) do
    i = jlist.get(i)
    if i.isDirectory() then
      fullpath = i.getAbsolutePath()
      for j in path.listdir(fullpath) do
        if j.name == "app.cfg" then
          projects.append(fullpath)
        end
      end
    end
  end
  return projects
end

abis = [
  "armeabi-v7a",
  "arm64-v8a",
  "x86",
  "x86_64"
]

function collect_libs(libsDir)
  ret = []

  if not path.isdir(libsDir) then
    return ret
  end
  
  for i in abis do
    abiPath = libsDir + "/" + i
    if not (path.exists(abiPath) and path.isdir(abiPath)) then
      continue
    end
    for j in path.listdir(abiPath) do
      if j.type != "file" then
        continue
      end
      if j.name.startswith("lib") and j.name.endswith(".so") then
        // ["armeabi-v7a/libsaynaa.so"]
        ret.append(i .. "/" .. j.name)
      end
    end
  end
  
  return ret
end

function extractFile(zipFile, FileToExtract, PathToSave)
  z = Zip.ZipFile(zipFile, "r")
  data = z.read(FileToExtract)
  writeFile(PathToSave, data)
end

function readFile(file)
  if not (path.exists(file) and path.isfile(file)) then
    error("$file not exists or is not file")
    return null
  end

  r = io.open(file, "r")
  content = r.read()
  r.close()
  return content
end

function writeFile(file, content)
  r = io.open(file, "w")
  r.write(content)
  r.close()
end

function readWrite(file, content)
  if not (content is Map) then
    return false
  end

  buffer = readFile(file)

  for i in content.keys do
    buffer = buffer.replace(i, content.get(i))
  end

  writeFile(file, buffer)
  return true
end

function newProject(temple, root, name, pkg)
  project = root + "/" + name
  if path.exists(project) then
    project = project .. "_" .. math.rand()
  end
  
  if path.exists(project) then
    return null
  end

  FileUtil.makeDir(project)
  Zip.ZipFile(temple, "r").extractall(project)
  
  appcfg = project + "/app.cfg"
  readWrite(appcfg, {"</>AppName</>": name, "</>PackageName</>": pkg})
  
  main = project + "/main.sa"
  readWrite(main, {"</>AppName</>": name, "</>PackageName</>": pkg})

  return project
end

function copyToClipboard(context, text)
  Context = java.bindClass("android.content.Context")
  ClipData = java.bindClass("android.content.ClipData")
  ClipboardManager = java.bindClass("android.content.ClipboardManager")

  clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE)

  clip = ClipData.newPlainText("text", text)
  clipboard.setPrimaryClip(clip)
end

// its better to use saynaa buildin if available future
function createFile(path)
  File = java.bindClass("java.io.File")
  file = File(path)
  if not file.exists() then
    return file.createNewFile()
  end
  return false
end

function createDirectory(path)
  File = java.bindClass("java.io.File")
  dir = File(path)
  if not dir.exists() then
    return dir.mkdirs()
  end
  return false
end

function rename(oldPath, newPath)
  File = java.bindClass("java.io.File")
  return File(oldPath).renameTo(File(newPath));
end

function copyHelper(source, destination)
  Files = java.bindClass("java.nio.file.Files")
  Paths = java.bindClass("java.nio.file.Paths")
  Options = java.bindClass("java.nio.file.StandardCopyOption")

  return Files.copy(Paths.get(source), Paths.get(destination), Options.REPLACE_EXISTING)
end

function copy(source, destination)
  result = pcall(copyHelper, source, destination)
  writeFile(destination .. "/info", "$source -> $destination\n${str(result)}")
  return str(result[1]) == str(destination)
end