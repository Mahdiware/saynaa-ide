import "android.widget.*"
import "android.view.*"
import "android.text.*"
import "android.graphics.*"
import "android.graphics.drawable.*"
import "android.app.AlertDialog"
import "android.app.*"
import "android.os.Bundle"
import "android.content.Intent"
import "com.saynaa.adapter.*"
import "com.saynaa.view.*"
import "com.saynaa.utils.FileUtil"

actionBar = activity.getActionBar()
actionBar.setDisplayHomeAsUpEnabled(true);
actionBar.setDisplayShowHomeEnabled(false);

androidR = java.bindClass('android.R')

AdapterData = []
adapter = null

function openFolder(_path)
  AdapterData.clear()
  AdapterData.append({
    icon: "icons/folder.png",
    type: "folder",
    title: "../",
    path: _path,
    subtitle: "Return to parent directory"
  })
  
  jlist = FileUtil.listDir(_path)
  length = java.length(jlist)
  
  for i in 0..(length) do
    i = jlist.get(i)
    icon = "icons/file.png"
    type = "file"
    title = i.getName()
    if i.isDirectory() then
      icon = "icons/folder.png"
      type = "folder"
    else
      if not title.endswith(".syp") then
        continue
      end
    end

    path = i.getAbsolutePath()
    modified = FileUtil.formatDate(i.lastModified(), "dd MMM yyyy, hh:mm a")
    AdapterData.append({icon: icon, type: type, title: title, subtitle: modified, path: path})
  end
end

function onOptionsItemSelected(item)
  if item.getItemId() == androidR.id.home then
    activity.finish()
    return true
  end
end

function onCreate(bundle)
  activity.setTitle("Choose source code (*.syp)")
  layout = loadlayout(activity, loadfile(saynaadir .. "/filemanager_layout.ly"))
  activity.setContentView(layout)
  
  rootpath = "/sdcard"
  parentDirectory = [rootpath]
  openFolder(rootpath)
  
  adapter = SaynaaAdapter(activity, loadfile(saynaadir .. "/utils/layout/filemanager.ly"), AdapterData)
  list.setAdapter(adapter)

  list.setOnItemClickListener({
    onItemClick: function(parent, view, position, id)
      data = AdapterData[position]
      if data.type == "file" then
        name = data.title
        if name.endswith(".syp") then
          b = Bundle()
          b.putString('project', data.path)
          activity.addActivityFlag(Intent.FLAG_ACTIVITY_NEW_TASK)
          activity.addActivityFlag(Intent.FLAG_ACTIVITY_CLEAR_TOP)
          activity.newActivity("main", b)
        end
      else
        currect = parentDirectory[-1]
        if data.title == "../" and currect == rootpath then
          return
        end
        if data.title == "../" then
          parentDirectory.pop()
          parent = parentDirectory[-1]
          openFolder(parent)
          adapter.notifyDataSetChanged()
        else
          goto = currect + "/" + data.title
          parentDirectory.append(goto)
          openFolder(goto)
          adapter.notifyDataSetChanged()
        end
      end
    end
  })
end