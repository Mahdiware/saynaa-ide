import "android.widget.*"
import "androidx.drawerlayout.widget.*"
import "androidx.cardview.widget.*"
import "android.view.*"
import "android.text.*"
import "android.graphics.*"
import "android.graphics.drawable.*"
import "android.app.AlertDialog"
import "android.app.*"
import "android.os.Bundle"
import "android.content.Intent"
import "com.android.saynaa.adapter.*"
import "com.android.saynaa.utils.FileUtil"

activity.getActionBar().hide()

result = 0
resourceId = activity.getResources().getIdentifier("status_bar_height", "dimen", "android");

if resourceId > 0 then
  result = activity.getResources().getDimensionPixelSize(resourceId);
end

function toast(msg)
	Toast.makeText(activity, msg, Toast.LENGTH_SHORT).show()
end

function openFolder(_path)
  data = [
    {
      icon: "icons/folder.png",
      type: "folder",
      title: "../",
      path: _path,
      subtitle: "Return to parent directory"
    }
  ]
  for i in FileUtil.listDir(_path) do
    icon = "icons/file.png"
    type = "file"
    title = i.getName()
    if i.isDirectory() then
      icon = "icons/folder.png"
      type = "folder"
    else
      if not title.endswith(".syp") then
        continue
      end
    end

    path = i.getAbsolutePath()
    modified = FileUtil.formatDate(i.lastModified(), "dd MMM yyyy, hh:mm a")
    data.append({icon: icon, type: type, title: title, subtitle: modified, path: path})
  end
  return data
end

function onCreate(bundle)
  layout = loadlayout(activity, load(saynaadir .. "/filemanager_layout.ly"))
  activity.setContentView(layout)
  
  rootpath = "/sdcard"
  parentDirectory = [rootpath]
  AdapterData = openFolder(rootpath)
  
  adapter = SaynaaAdapter(activity, load(saynaadir .. "/utils/layout/filemanager.ly"), AdapterData)
  list.setAdapter(adapter)
  
  back.setOnClickListener({
    onClick: function(v)
      activity.finish()
    end
  })

  list.setOnItemClickListener({
    onItemClick: function(parent, view, position, id)
      data = AdapterData[position]
      
      if data.type == "file" then
        name = data.title
        if name.endswith(".syp") then
          b = Bundle()
          b.putString('project', data.path)
          activity.addActivityFlag(Intent.FLAG_ACTIVITY_NEW_TASK)
          activity.addActivityFlag(Intent.FLAG_ACTIVITY_CLEAR_TOP)
          activity.newActivity("main", b)
        end
      else
        currect = parentDirectory[-1]
        if data.title == "../" and currect == rootpath then
          return
        end
        if data.title == "../" then
          parentDirectory.pop()
          parent = parentDirectory[-1]
          AdapterData = openFolder(parent)
          
          adapter = SaynaaAdapter(activity, load(saynaadir .. "/utils/layout/filemanager.ly"), AdapterData)
          list.setAdapter(adapter)
        else
          goto = currect + "/" + data.title
          parentDirectory.append(goto)
          AdapterData = openFolder(goto)
          
          adapter = SaynaaAdapter(activity, load(saynaadir .. "/utils/layout/filemanager.ly"), AdapterData)
          list.setAdapter(adapter)
        end
      end
    end
  })
end