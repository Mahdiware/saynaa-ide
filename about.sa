import "android.widget.*"
import "android.view.*"
import "android.graphics.*"
import "android.graphics.drawable.*"
import "android.content.*"
import "android.content.Intent"
import "android.net.Uri"

import utils.ui_utils

function onCreate()
  root = loadlayout(activity, loadfile(saynaadir .. "/about_layout.ly"))
  activity.setContentView(root)

  Github.setOnClickListener(({
    onClick: function(v)
      java.toast("Opening GitHub")

      intent = Intent(Intent.ACTION_VIEW)
      intent.setData(Uri.parse("https://github.com/mahdiware/saynaa-ide"))
      activity.startActivity(intent)
    end
  }))

  Share.setOnClickListener(({
    onClick: function(v)
      java.toast("Share SaynaaIDE")

      intent = Intent(Intent.ACTION_SEND)
      intent.setType("text/plain")
      intent.putExtra(Intent.EXTRA_SUBJECT, "SaynaaIDE")
      intent.putExtra(Intent.EXTRA_TEXT, "Check out SaynaaIDE on GitHub:\nhttps://github.com/mahdiware/saynaa-ide")
      activity.startActivity(Intent.createChooser(intent, "Share via"))
    end
  }))
end