Layout = {
  DrawerLayout,
  id: "mDrawer",
  loadfile("main_layout.ly"),
  loadfile("main_drawer.ly")
}

assert(activity != null, 'activity is null')

root = loadlayout(activity, Layout)
assert(root != null, 'loadlayout returned null')
activity.setContentView(root)

externaldir = "/storage/emulated/0/.SaynaaIDE" #activity.getSaynaaExtDir()
projectdir = externaldir .. "/project"
sharedir = externaldir .. "/.share"
appData = []
app_adapter = null

if permissions.requestStoragePermission(activity) then
  if not path.exists(projectdir) then
    FileUtil.makeDir(projectdir)
  end
end

function ShareProject(context, appinfo)
  Runnable = java.bindClass("java.lang.Runnable")
  Thread = java.bindClass("java.lang.Thread")

  dlg = dialog_utils.createProgressDialog(context);
  dlg.setTitle("Sharing");
  dlg.setMessage("Sharing...")
  dlg.setMax(100);
  dlg.show()
  
  runner = Runnable(function()
    dlg.setCancelable(false);
    
    result = pcall(function()
      file_utils.createDirectory(sharedir)
      sharefile = sharedir .. "/" .. appinfo.appname .. "_" .. appinfo.versionname .. ".syp"
      FileUtil.deleteFile(sharefile)
      file_utils.addZipFolder(sharefile, null, appinfo.project)
      permissions.shareProject(activity, sharefile)
    end)
    dlg.setCancelable(true);
    if not result[0] then
      dlg.setMessage("error: " .. str(result[1]))
    else
      dlg.dismiss()
    end
  end)
  
  thread = Thread(runner)
  thread.start()
end

function fileMenuBuilder(appinfo)
  callback = {
    onMenuItemClick: function(item)
      id = item.getItemId()

      if id == 0 then
        b = Bundle()
        b.putString('project', appinfo.project)
        activity.newActivity("properties", b)
      elif id == 1 then
        apkbuilder.BuildApk(activity, appinfo.project)
      elif id == 2 then
        ShareProject(activity, appinfo)
      elif id == 3 then
        deleteProject(appinfo)
      end
      
      return true
    end
  }

  return {
    onClick: function(v)
      pop=PopupMenu(activity, v)
      menu=pop.getMenu()
  
      menu.add(0, 0, 0, "Config")
      menu.add(0, 1, 0, "Build")
      menu.add(0, 2, 0, "Share")
      menu.add(0, 3, 0, "Delete")
      
      pop.setOnMenuItemClickListener(callback)
      pop.show();
    end
  }
end

function updateAppData(project, index)
  result = pcall(config_validate.getConfig, project)

  if not result[0] then
    return
  end

  cfg = result[1]
  
  appinfo = {
    appname : cfg.appname,
    versionname: cfg.versionName,
    project: project,
    appicon: cfg.appicon,
    appversion : "Version: " .. cfg.versionName,
    package : "Package name: " .. cfg.pkgname,
    filemenu: fileMenuBuilder(appinfo)
  }
  
  if index is Number then
    appData.insert(index, appinfo)
  else
    appData.append(appinfo)
  end
end

function getAppData(projects)
  for _path in projects do
    updateAppData(_path)
  end
end

function refreshAppList()
  
end

function importProject(project_path)
  zp = Zip.ZipFile(project_path, "r")
  tmp_file = activity.getCacheDir().getAbsolutePath() .. "/tmp.cfg"
  zp.extract_file("app.cfg", tmp_file)
  cfg = loadfile(tmp_file, 2)
  
  project_name = cfg.app.name
  pkg = cfg.app.package
  version = cfg.app.versionName

  ll = LoadLayout(activity)
  objects = ll.getObjects()
  dialog = dialog_utils.createDialog(activity, ll.createView(loadfile("utils/layout/importproject.ly")))

  ok = objects.ok
  cancel = objects.cancel
  content = objects.content
  content.setText("Name: $project_name\nVersion: $version\nPackage Name: $pkg\nPath: $project_path")

  ok.setOnClickListener({
    onClick: function(v)
      project = projectdir + "/" + project_name
      if path.exists(project)
        project = project .. "_" .. math.rand()
      end

      if path.exists(project) then
        project = project .. "_" .. math.rand()
      end

      FileUtil.makeDir(project)
      Zip.ZipFile(project_path, "r").extractall(project)
      updateAppData(project, 0)
      app_adapter.notifyDataSetChanged()
      java.toast("Project Imported")
      
      dialog.dismiss();
    end
  })

  cancel.setOnClickListener({
    onClick: function(v)
      dialog.dismiss()
    end
  })
end

function getProjectIndex(project)
  index = 0
  for i in appData do
    if i.project == project then
      return index
    end
    index += 1
  end
end

function deleteProject(appinfo)
  project_path = appinfo.project
  project_name = appinfo.appname

  ll = LoadLayout(activity)
  objects = ll.getObjects()
  dialog = dialog_utils.createDialog(activity, ll.createView(loadfile(saynaadir .. "/utils/layout/deleteproject.ly")))

  delete = objects.delete 
  cancel = objects.cancel
  content = objects.content
  content.setText( "Are you sure you want to delete this project named '$project_name'?\n\nThis action cannot be undone.")

  delete.setOnClickListener({
    onClick: function(v)
      if FileUtil.deleteFile(project_path) then
        appData.pop(getProjectIndex(appinfo.project))
        app_adapter.notifyDataSetChanged()
        java.toast("Project Deleted")
      end
      
      dialog.dismiss();
    end
  })

  cancel.setOnClickListener({
    onClick: function(v)
      dialog.dismiss()
    end
  })
end

function newProject()
  ll = LoadLayout(activity)
  objects = ll.getObjects()
  dialog = dialog_utils.createDialog(activity, ll.createView(loadfile(saynaadir .. "/utils/layout/createproject.ly")))

  create = objects.create
  cancel = objects.cancel
  appName = objects.appName
  packageName = objects.packageName
  packageName.setText("com.example.myapp" .. math.rand())
  
  appNameError = false
  packageNameError = false

  create.setOnClickListener({
    onClick: function(v)
      name = appName.getText().strip();
      pkg = packageName.getText().strip();

      if (name == "") then
        appNameError = true
        appName.setError("Enter app name");
        return;
      end

      if appNameError then
        appName.clearError()
      end

      if (pkg == "") then
        packageNameError = true
        packageName.setError("Enter package name");
        return;
      end
      
      if validator.is_invalid_package(pkg) then
        packageNameError = true
        packageName.setError("Enter valid package name");
        return;
      end
      
      if packageNameError then
        packageName.clearError()
      end

      project = file_utils.newProject(saynaadir .. "/res/template.zip", projectdir, name, pkg)
      if(project != null)
        updateAppData(project, 0)
        app_adapter.notifyDataSetChanged()
        java.toast("Project Created")
        b = Bundle()
        b.putString('project', project)
        b.putString('name', name)
        activity.newActivity("editor", b)
      else
        java.toast("Project Creation failed!")
      end
    
      dialog.dismiss();
    end
  })

  cancel.setOnClickListener({
    onClick: function(v)
      dialog.dismiss()
    end
  })
end

lastBackPressTime = 0

function onBackPressed()
  currentTime = time.nano()
  diff = currentTime - lastBackPressTime

  // 2,000,000,000 ns = 2 seconds
  if diff > 2000000000
    lastBackPressTime = currentTime
    java.toast("Press back again to exit")
    return true
  end
end

function onKeyDown(keyCode, even)
  if keyCode == KeyEvent.KEYCODE_BACK then
    if mDrawer.isDrawerOpen(3) then
      mDrawer.closeDrawer(3)
      return true
    end
  end
end

function onCreate(bundle)
  if bundle != null then
    project = bundle.getString("project")
    if project != null then
      importProject(project)
    end
  end

  drawer_adapter = SaynaaAdapter(activity, loadfile(saynaadir .. "/main_items.ly"), drawerData)
  drawer_list.setAdapter(drawer_adapter)
  drawer_list.setOnItemClickListener(({
    onItemClick: function(parent, view, position, id)
      callback = drawerData[position].callback
      if callback is Closure then
        callback()
      end
    end
  }))

  getAppData(file_utils.getProjects(projectdir))
  app_adapter = SaynaaAdapter(activity, loadfile(saynaadir .. "/main_applist.ly"), appData)
  app_list.setAdapter(app_adapter)
  app_list.setOnItemClickListener(({
    onItemClick: function(parent, view, position, id)
      b = Bundle()
      b.putString('project', appData[position].project)
      b.putString('name', appData[position].appname)
      activity.newActivity("editor", b)
    end
  }))
  
  app_list.setOnItemLongClickListener(({
    onItemLongClick: function(parent, view, position, id)
      b = Bundle()
      b.putString('project', appData[position].project)
      activity.newActivity("properties", b)
      return true
    end
  }))
  
  refresh.setOnClickListener({
    onClick: function(v)
      app_adapter.notifyDataSetChanged()
    end
  })
  
  pop=PopupMenu(activity, btnmenu)
  menu=pop.getMenu()
  
  menu.add(0, 0, 0, "Import Project")
  menu.add(0, 1, 0, "New Project")
  menu.add(0, 2, 0, "About")
  
  pop.setOnMenuItemClickListener({
    onMenuItemClick: function(item)
        id = item.getItemId()
        if id == 0 then
          activity.newActivity("filemanager")
        elif id == 1 then
          newProject()
        elif id == 2 then
          activity.newActivity("about")
        end
        return true
    end
  })
  
  btnmenu.setOnClickListener({
    onClick: function(v)
     pop.show();
    end
  })
  
  add.setOnClickListener({
    onClick: function(v)
      newProject()
    end
  })

  btn.setOnClickListener({
    onClick: function(v)
     mDrawer.openDrawer(3)
    end
  })
  
end
