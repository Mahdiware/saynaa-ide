activity.getActionBar().hide();
activity.getWindow().setStatusBarColor(Color.parseColor("#FF2196F3"));
activity.getWindow().getDecorView().setSystemUiVisibility(0);

result = 0
resourceId = activity.getResources().getIdentifier("status_bar_height", "dimen", "android");

if resourceId > 0 then
  result = activity.getResources().getDimensionPixelSize(resourceId);
end

function toast(msg)
	Toast.makeText(activity, msg, Toast.LENGTH_SHORT).show()
end

# Helper function to generate smooth, modern rounded backgrounds dynamically
function roundedRect(colorHex, radius)
  d = GradientDrawable()
  d.setShape(GradientDrawable.RECTANGLE)
  d.setCornerRadius(radius)
  d.setColor(Color.parseColor(colorHex))
  return d
end

drawerData = [
  {
    title: 'Settings',
    icon: 'icon/ic_cog.png',
    callback: function()
    end
    
  },
  {
    title: 'Delete',
    icon: 'icon/ic_delete.png',
    callback: function()
    end
  },
  {
    title: 'Contact',
    icon: 'icon/ic_message_processing.png',
    callback: function()
    end
  },
  {
    title:'Downloads',
    icon: 'icon/ic_download.png',
    callback: function()
    end
  },
  {
    title: 'Share',
    icon: 'icon/ic_share_variant.png',
    callback: function()
    end
  },
  {
    title: 'Exit',
    icon: 'icon/ic_power.png',
