activity.getActionBar().hide();

result = 0
resourceId = activity.getResources().getIdentifier("status_bar_height", "dimen", "android");

if resourceId > 0 then
  result = activity.getResources().getDimensionPixelSize(resourceId);
end

function toast(msg)
	Toast.makeText(activity, msg, Toast.LENGTH_SHORT).show()
end

drawerData = [
  {
    title: 'Settings',
    icon: 'icons/ic_cog.png',
    callback: function()
      activity.newActivity("settings")
      mDrawer.closeDrawer(3)
    end
    
  },
  {
    title: 'Contact',
    icon: 'icons/ic_message_processing.png',
    callback: function()
      intent = Intent(Intent.ACTION_VIEW)
      intent.setData(Uri.parse("https://t.me/mahdiware"))
      activity.startActivity(intent)
      mDrawer.closeDrawer(3)
    end
  },
  {
    title:'Downloads',
    icon: 'icons/ic_download.png',
    callback: function()
    end
  },
  {
    title: 'Share',
    icon: 'icons/ic_share_variant.png',
    callback: function()
      intent = Intent(Intent.ACTION_SEND)
      intent.setType("text/plain")
      intent.putExtra(Intent.EXTRA_SUBJECT, "SaynaaIDE")
      intent.putExtra(Intent.EXTRA_TEXT, "Check out SaynaaIDE on GitHub:\nhttps://github.com/mahdiware/saynaa-ide")
      activity.startActivity(Intent.createChooser(intent, "Share via"))
    end
  },
  {
    title: 'Exit',
    icon: 'icons/ic_power.png',
    callback: function()
      activity.finish()
    end
  },
]

Layout = {
  DrawerLayout,
  id: "mDrawer",
  load(saynaadir .. "/main_layout.ly"),
  load(saynaadir .. "/main_drawer.ly")
}

assert(activity != null, 'activity is null')

root = loadlayout(activity, Layout)
assert(root != null, 'loadlayout returned null')
activity.setContentView(Layout)

externaldir = activity.getSaynaaExtDir()
projectdir = externaldir .. "/project"
sharedir = externaldir .. "/.share"
projects = null
appData = null

permissions.requestStoragePermission(activity)

function ShareProject(context, index)
  Runnable = java.bindClass("java.lang.Runnable")
  Thread = java.bindClass("java.lang.Thread")

  dlg = dialog_utils.createProgressDialog(context);
  dlg.setTitle("Sharing");
  dlg.setMessage("Sharing...")
  dlg.setMax(100);
  dlg.show()
  
  runner = Runnable(function()
    dlg.setCancelable(false);
    file_utils.createDirectory(sharedir)
    sharefile = sharedir .. "/" .. appData[index].appname .. ".syp"
    file_utils.addZipFolder(sharefile, null, projects[index])
    permissions.shareProject(activity, sharefile)
    dlg.setCancelable(true);
    dlg.dismiss()
  end)
  
  thread = Thread(runner)
  thread.start()
end

function fileMenuBuilder(index)
  callback = {
    onMenuItemClick: function(item)
      id = item.getItemId()
      if id == 0 then
        apkbuilder.BuildApk(activity, projects[index])
      elif id == 1 then
        ShareProject(activity, index)
      elif id == 2 then
        deleteProject(index)
      end
      
      return true
    end
  }

  return {
    onClick: function(v)
      pop=PopupMenu(activity, v)
      menu=pop.getMenu()
  
      menu.add(0, 0, 0, "Build")
      //menu.add(0, 1, 0, "Clone")
      menu.add(0, 1, 0, "Share")
      menu.add(0, 2, 0, "Delete")
      
      pop.setOnMenuItemClickListener(callback)
      pop.show();
    end
  }
end

function getAppData(projects)
  data = {}
  index = 0
  for path in projects do
    cfg = package.loadfile(path + "/app.cfg")
    data[index] = {
      appname : cfg.app.name,
      appicon : path .. "/" .. cfg.app.icon,
      appversion : "Version: " .. cfg.app.versionName,
      package : "Package name: " .. cfg.app.package,
      filemenu: fileMenuBuilder(index)
    }

    index += 1
  end
  
  return data
end

function refreshAppList()
  projects = file_utils.getProjects(projectdir)
  appData = getAppData(projects)
  app_adapter = SaynaaAdapter(activity, load(saynaadir .. "/main_applist.ly"), appData)
  app_list.setAdapter(app_adapter)
end

import Zip, package, path, math, time

function importProject(project_path)
  zp = Zip.ZipFile(project_path, "r")
  tmp_file = activity.getCacheDir().getAbsolutePath() .. "/tmp.cfg"
  zp.extract_file("app.cfg", tmp_file)
  cfg = package.loadfile(tmp_file)
  
  project_name = cfg.app.name
  pkg = cfg.app.package
  version = cfg.app.versionName

  ll = LoadLayout(activity)
  objects = ll.getObjects()
  dialog = dialog_utils.createDialog(activity, ll.createView(load(saynaadir .. "/utils/layout/importproject.ly")))

  ok = objects.ok
  cancel = objects.cancel
  content = objects.content
  content.setText("Name: $project_name\nVersion: $version\nPackage Name: $pkg\nPath: $project_path")

  ok.setOnClickListener({
    onClick: function(v)
      project = projectdir + "/" + project_name
      if path.exists(project)
        project = project .. "_" .. math.rand()
      end
    
      FileUtil.makeDir(project)
      Zip.ZipFile(project_path, "r").extractall(project)
      refreshAppList()
      toast("Project Imported")
      
      dialog.dismiss();
    end
  })

  cancel.setOnClickListener({
    onClick: function(v)
      dialog.dismiss()
    end
  })
end

function deleteProject(index)
  project_path = projects[index]
  project_name = appData[index].appname

  ll = LoadLayout(activity)
  objects = ll.getObjects()
  dialog = dialog_utils.createDialog(activity, ll.createView(load(saynaadir .. "/utils/layout/deleteproject.ly")))

  delete = objects.delete 
  cancel = objects.cancel
  content = objects.content
  content.setText( "Are you sure you want to delete this project named '$project_name'?\n\nThis action cannot be undone.")

  delete.setOnClickListener({
    onClick: function(v)
      if os.system("rm -r '$project_path'") == 0 then
        refreshAppList()
        toast("Project Deleted")
      end
      
      dialog.dismiss();
    end
  })

  cancel.setOnClickListener({
    onClick: function(v)
      dialog.dismiss()
    end
  })
end

function newProject()
  ll = LoadLayout(activity)
  objects = ll.getObjects()
  dialog = dialog_utils.createDialog(activity, ll.createView(load(saynaadir .. "/utils/layout/createproject.ly")))

  create = objects.create
  cancel = objects.cancel
  appName = objects.appName
  packageName = objects.packageName
  packageName.setText("com.example.myapp" .. math.rand())

  create.setOnClickListener({
    onClick: function(v)
      name = appName.getText().strip();
      pkg = packageName.getText().strip();

      if (name == "") then
        appName.setError("Enter app name");
        return;
      end

      if (pkg == "") then
        packageName.setError("Enter package name");
        return;
      end
      
      if validator.is_invalid_package(pkg) then
        packageName.setError("Enter valid package name");
        return;
      end

      if(file_utils.buildProject(projectdir, name, pkg))
        refreshAppList()
        toast("Project Created")
        b = Bundle()
        b.putString('project', projectdir .. "/" .. name)
        b.putString('name', name)
        activity.newActivity("editor", b)
      else
        toast("Project Creation failed!")
      end
    
      dialog.dismiss();
    end
  })

  cancel.setOnClickListener({
    onClick: function(v)
      dialog.dismiss()
    end
  })
end

lastBackPressTime = 0

function onBackPressed()
  currentTime = time.nano()
  diff = currentTime - lastBackPressTime

  // 2,000,000,000 ns = 2 seconds
  if diff < 2000000000
    activity.finish()
  else
    lastBackPressTime = currentTime
    toast("Press back again to exit")
    return true
  end
end

function onKeyDown(keyCode, even)
  if keyCode == KeyEvent.KEYCODE_BACK then
    if mDrawer.isDrawerOpen(3) then
      mDrawer.closeDrawer(3)
      return true
    end
  end
end

function onCreate(bundle)
  if bundle != null then
    project = bundle.getString("project")
    if project != null then
      importProject(project)
    end
  end

  drawer_adapter = SaynaaAdapter(activity, load(saynaadir .. "/main_items.ly"), drawerData)
  drawer_list.setAdapter(drawer_adapter)
  drawer_list.setOnItemClickListener(({
    onItemClick: function(parent, view, position, id)
      callback = drawerData[position].callback
      if callback is Closure then
        callback()
      end
    end
  }))
  
  refreshAppList();
  app_list.setOnItemClickListener(({
    onItemClick: function(parent, view, position, id)
      b = Bundle()
      b.putString('project', projects[position])
      b.putString('name', appData[position].appname)
      activity.newActivity("editor", b)
    end
  }))
  
  app_list.setOnItemLongClickListener(({
    onItemLongClick: function(parent, view, position, id)
      deleteProject(position)
      return true
    end
  }))
  
  refresh.setOnClickListener({
    onClick: function(v)
      refreshAppList()
    end
  })
  
  pop=PopupMenu(activity, btnmenu)
  menu=pop.getMenu()
  
  menu.add(0, 0, 0, "Import Project")
  menu.add(0, 1, 0, "New Project")
  menu.add(0, 2, 0, "About")
  
  pop.setOnMenuItemClickListener({
    onMenuItemClick: function(item)
        id = item.getItemId()
        if id == 0 then
          activity.newActivity("filemanager")
        elif id == 1 then
          newProject()
        elif id == 2 then
          activity.newActivity("about")
        end
        return true
    end
  })
  
  btnmenu.setOnClickListener({
    onClick: function(v)
     pop.show();
    end
  })
  
  add.setOnClickListener({
    onClick: function(v)
      newProject()
    end
  })

  btn.setOnClickListener({
    onClick: function(v)
     mDrawer.openDrawer(3)
    end
  })
end
