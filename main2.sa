import "android.widget.*"
import "androidx.drawerlayout.widget.*"
import "androidx.cardview.widget.*"
import "android.view.*"
import "android.text.*"
import "android.os.*"
import "android.graphics.*"
import "com.android.saynaa.*"
import "com.android.saynaa.adapter.*"
import "android.content.*"
import "com.android.saynaa.*"
import "android.graphics.*"
import "android.graphics.drawable.*"

import utils, apkbuilder


activity.getActionBar().hide()

result = 0
resourceId = activity.getResources().getIdentifier("status_bar_height", "dimen", "android");

if resourceId > 0 then
  result = activity.getResources().getDimensionPixelSize(resourceId);
end

function toast(msg)
	Toast.makeText(activity, msg, Toast.LENGTH_SHORT).show()
end

# Helper function to generate smooth, modern rounded backgrounds dynamically
function roundedRect(colorHex, radius)
  d = GradientDrawable()
  d.setShape(GradientDrawable.RECTANGLE)
  d.setCornerRadius(radius)
  d.setColor(Color.parseColor(colorHex))
  return d
end

function openFolder(_path)
  data = [
    {
      icon: "icon/folder.png",
      type: "folder",
      title: "../",
      path: _path,
      subtitle: "Return to parent directory"
    }
  ]
  for i in utils.listPath(_path) do
    icon = "icon/file.png"
    type = "file"
    if i.type == "directory" then
      icon = "icon/folder.png"
      type = "folder"
    end
  
    title = i.name
    path = i.path # path is full path also added folder/file name
    data.append({icon: icon, type: type, title: title, subtitle: title, path: path})
  end
  return data
end

assert(activity != null, 'activity is null')

Layout = {
  DrawerLayout,
  id: "mDrawer",
  load("main2.ly"),
  load("drawer.ly")
}

root = loadlayout(activity, Layout)
assert(root != null, 'loadlayout returned null')
activity.setContentView(root)

openfile = null # i added global to use in onKeyDown()
project = null

function onKeyDown(c,e)
  if c==4 then
    if mDrawer.isDrawerOpen(3) then
      mDrawer.closeDrawer(3)
      return true
    end
    if openfile != null
      utils.writeFile(openfile, editor.getText())
    end
  end
end

function onCreate(bundle)
  if bundle == null then
    toast("bundle is null")
    return
  end
  
  project = bundle.getString("project")

  openfile = project .. "/main.sa"
  filename.setText("main.sa")
  editor.setText(utils.readFile(openfile))

  redo.setOnClickListener({
    onClick: function(v)
      editor.redo();
    end
  })

  btn.setOnClickListener({
    onClick: function(v)
     mDrawer.openDrawer(3)
    end
  })

  undo.setOnClickListener({
    onClick: function(v)
      editor.undo();
    end
  })

  run.setOnClickListener({
    onClick: function(v)
      utils.writeFile(openfile, editor.getText())
      activity.newActivity(project .. "/main")
    end
  })
  
  pop=PopupMenu(activity, btnmenu)
  menu=pop.getMenu()
  
  menu.add(0, 0, 0, "Build")
  menu.add(0, 1, 0, "About")
  
  pop.setOnMenuItemClickListener({
    onMenuItemClick: function(item)
        id = item.getItemId()
        if id == 0 then
          BuildApk()
        end
        return true
    end
  })
  
  btnmenu.setOnClickListener({
    onClick: function(v)
     pop.show();
    end
  })
  
  save.setOnClickListener({
    onClick: function(v)
     utils.writeFile(openfile, editor.getText())
     toast("Save successful")
    end
  })
  
  rootpath = project
  parentDirectory = [rootpath]
  AdapterData = openFolder(rootpath)
  
  adapter = SaynaaAdapter(activity, load("filemanager.ly"), AdapterData)
  drawer_list.setAdapter(adapter)

  drawer_list.setOnItemClickListener(({
    onItemClick: function(parent, view, position, id)
      data = AdapterData[position]
      
      if data.type == "file" then
        name = data.title
        if name.endswith(".sa") or name.endswith(".cfg") then
          utils.writeFile(openfile, editor.getText())
          openfile = data.path
          filename.setText(name)
          editor.setText(utils.readFile(openfile))
          mDrawer.closeDrawer(3)
        end
      else
        currect = parentDirectory[-1]
        if data.title == "../" and currect == rootpath then
          return
        end
        if data.title == "../" then
          parentDirectory.pop()
          parent = parentDirectory[-1]
          AdapterData = openFolder(parent)
          
          adapter = SaynaaAdapter(activity, load("filemanager.ly"), AdapterData)
          drawer_list.setAdapter(adapter)
        else
          goto = currect + "/" + data.title
          parentDirectory.append(goto)
          AdapterData = openFolder(goto)
          
          adapter = SaynaaAdapter(activity, load("filemanager.ly"), AdapterData)
          drawer_list.setAdapter(adapter)
        end
      end
    end
  }))
end

function BuildApk()
  if project == null
    toast("something wrong!")
    return
  end
  
  cfg = package.load(project + "/app.cfg")
  
  saynaadir = activity.getSaynaaExtDir()
  apkbuilder.build(activity, cfg, project, saynaadir .. "/bin")
  toast("successful apk builded")
end