import "android.widget.*"
import "android.view.*"

import utils.ui_utils, utils.bytecode_utils
AndroidRId = java.bindClass('android.R$id')

actionBar = activity.getActionBar()
actionBar.setDisplayHomeAsUpEnabled(true);
actionBar.setDisplayShowHomeEnabled(false);

function switchItem(itemid, icon, title, desc, checked)
  return {
    LinearLayout,
    orientation:"horizontal",
    gravity:"center_vertical",
    onClick: function(v)
      if itemid == null then
        return
      end
      
      // get switch id in currect module globals and toggle it
      globals = _module.globals()
      if globals.has(itemid) then
        globals.get(itemid).toggle();
      end
    end,
    padding:"12dp",
    layout_width:"match_parent",
    layout_height:"wrap_content",

    {
      ImageView,
      src: icon,
      colorFilter: 0xFFFFFFFF,
      gravity:"center",
      layout_width:"42dp",
      layout_height:"42dp",
      scaleType: "centerCrop",
      padding: "6dp",
      background: ui_utils.roundBg(0xff6750A4,21),
    },

    {
      LinearLayout,
      orientation:"vertical",
      layout_weight:"1",
      layout_marginLeft:"14dp",
      layout_height:"wrap_content",

      {
        TextView,
        text:title,
        textSize:"16sp",
      },

      {
        TextView,
        text:desc,
        textSize:"13sp",
      },
    },

    {
      Switch,
      id: itemid,
      checked: checked,
    },
  }
end

function buttonItem(itemid, icon, title, desc)
  return {
    LinearLayout,
    id: itemid,
    orientation:"horizontal",
    gravity:"center_vertical",
    layout_width:"match_parent",
    padding:"12dp",

    {
      ImageView,
      src: icon,
      colorFilter: 0xFFFFFFFF,
      gravity:"center",
      layout_width:"42dp",
      layout_height:"42dp",
      padding: "6dp",
      background: ui_utils.roundBg(0xff6750A4,21),
    },

    {
      LinearLayout,
      orientation:"vertical",
      layout_weight:"1",
      layout_marginLeft:"14dp",

      {
        TextView,
        text: title,
        textSize:"16sp",
      },

      {
        TextView,
        text: desc,
        textSize:"13sp",
      },
    },

    {
      TextView,
      text: ">",
      textSize:"18sp",
      textColor:"#999999",
      layout_marginRight:"14dp",
    },
  }
end

layout={
  LinearLayout,
  orientation:"vertical",
  layout_width:"match_parent",
  layout_height:"match_parent",

  {
    ScrollView,
    layout_width:"match_parent",
    layout_height:"0dp",
    layout_weight:"1",

    {
      LinearLayout,
      orientation:"vertical",
      padding:"16dp",
      layout_width:"match_parent",
      layout_height:"wrap_content",

      {
        EditText,
        hint:"Search settings",
        layout_width:"match_parent",
        layout_height:"48dp",
        background:ui_utils.roundBg(theme.cards, 24),
        paddingLeft:"16dp",
        paddingRight:"16dp",
      },

      {
        TextView,
        text:"General",
        textSize:"13sp",
        textStyle:"bold",
        textColor:"#777777",
        layout_marginTop:"20dp",
        layout_marginBottom:"8dp",
      },

      {
        LinearLayout,
        orientation:"vertical",
        background:ui_utils.roundBg(theme.cards, 20),
        layout_width:"match_parent",
        layout_height:"wrap_content",
        
        switchItem(null, "icons/ic_create.png","Syntax Highlight","Highlight Saynaa code",true),
        switchItem("darktheme", "icons/theme.png","Dark Theme","Use dark interface",false),
        switchItem(null, "icons/ic_copy.png","Auto Save","Save files automatically",true),

        buttonItem(null, "icons/ic_image.png", "Appearance", "Theme, colors and fonts"),
        buttonItem(null, "icons/ic_edit.png", "Editor", "Code editor preferences"),
        buttonItem("about", "icons/documentation.png", "About", "Version, licenses and credits"),
      },

      {
        TextView,
        text:"Advanced",
        textSize:"13sp",
        textStyle:"bold",
        textColor:"#777777",
        layout_marginTop:"20dp",
        layout_marginBottom:"8dp",
      },

      {
        LinearLayout,
        orientation:"vertical",
        gravity:"center_vertical",
        background:ui_utils.roundBg(theme.cards, 20),
        layout_width:"match_parent",
        layout_height:"match_parent",

        switchItem("compiling", "icons/ic_keystore.png", "Bytecode Compilation", "Compile source code into bytecode", true),
      },

      {
        Button,
        text:"Reset Settings",
        layout_width:"match_parent",
        layout_height:"48dp",
        layout_marginTop:"24dp",
        background:ui_utils.roundBg(0xff6750A4,24),
        textColor:"#F5F5F5",
      },

      {
        TextView,
        text:"SaynaaIDE",
        layout_gravity: "center",
        textSize:"12sp",
        textColor:"#999999",
        layout_marginTop:"16dp",
        layout_marginBottom:"24dp",
      },

    },
  },
}

function onOptionsItemSelected(item)
  if item.getItemId() == AndroidRId.home then
    activity.finish()
    return true
  end
end


view = loadlayout(activity, layout)
activity.setContentView(view)
function onCreate(bundle)
  darktheme.setChecked(theme.isDarkMode())
  darktheme.setOnCheckedChangeListener({
    onCheckedChanged: function(v, checked)
      theme.setDarkMode(checked)
      activity.finishAffinity()
      activity.newActivity("main")
    end
  })

  compiling.setChecked(bytecode_utils.isBytecodeEnabled(activity))
  compiling.setOnCheckedChangeListener({
    onCheckedChanged: function(v, checked)
      bytecode_utils.setBytecodeEnabled(activity, checked)
    end
  })
  
  about. setOnClickListener({
    onClick: function(v)
      activity.newActivity("about")
    end
  })
end