function toast(msg)
  Toast.makeText(activity, msg, Toast.LENGTH_SHORT).show()
end

function roundBg(color, radius)
  bg = GradientDrawable()
  bg.setColor(Color.parseColor(color))
  bg.setCornerRadius(radius)
  return bg
end

function strokeBg(color, stroke, strokeColor, radius)
  bg = GradientDrawable()
  bg.setColor(Color.parseColor(color))
  bg.setCornerRadius(radius)
  bg.setStroke(stroke, Color.parseColor(strokeColor))
  return bg
end

