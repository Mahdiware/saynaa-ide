function onCreate()
  root = loadlayout(activity, AboutLayout)
  activity.setContentView(root)

  Github.setOnClickListener(({
    onClick: function(v)
      toast("Opening GitHub")
      intent = Intent(Intent.ACTION_VIEW)
      intent.setData(Uri.parse("https://github.com/mahdiware"))
      activity.startActivity(intent)
    end
  }))

  Share.setOnClickListener(({
    onClick: function(v)
      toast("Share SaynaaIDE")

      intent = Intent(Intent.ACTION_SEND)
      intent.setType("text/plain")
      intent.putExtra(Intent.EXTRA_SUBJECT, "SaynaaIDE")
      intent.putExtra(Intent.EXTRA_TEXT, "Check out SaynaaIDE on GitHub:\nhttps://github.com/mahdiware")
      activity.startActivity(Intent.createChooser(intent, "Share via"))
    end
  }))
end